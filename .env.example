# Copy to .env and fill in. .env is never committed.
# 複製成 .env 再填入；.env 不會進 git。

# Required — random strings (e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=change-me
MEDIA_SECRET=change-me            # signs the short-lived audio links
SEARXNG_SECRET=change-me          # the bundled lyrics search engine

# Optional
# API_BIND=0.0.0.0                # 127.0.0.1 = only this computer (e.g. behind your own reverse proxy)
# API_PORT=8000
# BACKUP_DIR=./data/backups       # daily backups (database + songs), 14 kept
# TZ=UTC                          # log time zone, POSIX form, e.g. CST-8 for Taipei
# WORKER_NAME=worker              # keep it fixed: unfinished jobs are resumed by name after a restart
# Features (on by default; set to 0 to turn off)
# URL_IMPORT=1                    # paste a YouTube / video link instead of uploading a file (yt-dlp)
# WEB_LYRICS=1                    # search lyrics sites when LRCLIB has no synced lyrics
